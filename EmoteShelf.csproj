<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.3.9.27</Version>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <Author>CheesyChiz</Author>
    <Name>Emote Shelf</Name>
    <InternalName>EmoteShelf</InternalName>
    <Punchline>One-click bookmarks for Penumbra emote mods.</Punchline>
    <Description>Browse Penumbra emote mods, choose variants, and pin favorites to an icon panel. Supports ground-sit and standing-idle poses. Experimental pair launch includes required alignment and needs Lightless Sync with your partner. Technical error reports are mandatory after accepting the first-use notice; collection cannot be disabled while using the plugin. Open with /es or /eshelf. Solo playback requires only Penumbra.</Description>
    <Tags>emote;dance;penumbra;overlay</Tags>
    <RepoUrl>https://github.com/CheesyChiz/EmoteShelf</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/CheesyChiz/EmoteShelf/main/assets/icon.png</IconUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PenumbraLibPath Condition="'$(PenumbraLibPath)' == ''">$(APPDATA)\XIVLauncher\installedPlugins\Penumbra\1.7.2.1</PenumbraLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Reference Include="Penumbra.Api">
      <HintPath>$(PenumbraLibPath)\Penumbra.Api.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Luna">
      <HintPath>$(PenumbraLibPath)\Luna.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
